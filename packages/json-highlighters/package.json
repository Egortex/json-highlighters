{
	"name": "@chepchik/json-highlighters",
	"version": "1.0.3",
	"description": "Три подхода к живой редактируемой подсветке JSON в React: regex, AST-токенизатор с позициями и AST внутри contentEditable.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Egortex/json-highlighters.git"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"keywords": [
		"json",
		"react",
		"react-component",
		"syntax-highlighting",
		"json-viewer",
		"json-editor",
		"code-editor",
		"regex",
		"ast",
		"parser",
		"tokenizer",
		"contenteditable"
	],
	"scripts": {
		"build": "vite build && npm run copy:css",
		"copy:css": "node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
		"dev": "vite build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"prepare": "npm run build",
		"release": "standard-version",
		"postrelease": "git push --follow-tags origin main && npm publish"
	},
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"jsdom": "^30.0.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"standard-version": "^9.5.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	}
}
