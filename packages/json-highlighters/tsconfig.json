{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"moduleResolution": "bundler",
		"lib": ["dom", "esnext"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
